# Copy to deploy/.env (chmod 600 — it holds secrets) and fill in.

# --- image -------------------------------------------------------------------
WISHLIST_IMAGE=wishlist
WISHLIST_TAG=latest

# --- where the outer nginx reaches this container -----------------------------
APP_BIND=127.0.0.1
APP_PORT=8080
# Addresses of the outer nginx, comma- or space-separated. Client IPs are taken from
# X-Forwarded-For only for these; everything else is treated as the real client.
TRUSTED_PROXY_CIDR=127.0.0.1,172.16.0.0/12

# --- public identity ----------------------------------------------------------
# Scheme + host the users see; used for CORS.
PUBLIC_ORIGIN=https://wishlist.example.com
# Leave empty: the SPA calls /v1 on its own origin and the inner nginx proxies it.
PUBLIC_API_URL=

# --- external Postgres --------------------------------------------------------
DB_URL=jdbc:postgresql://db.example.com:5432/wishlist
DB_USER=wishlist
DB_PASSWORD=

# --- external Keycloak --------------------------------------------------------
# Public base URL — the browser is redirected here, so no internal hostname.
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_REALM=wishlist
KEYCLOAK_AUDIENCE=wishlist-api
KEYCLOAK_CLIENT_ID=wishlist-frontend
# Confidential client, service-account role realm-management/manage-users
KEYCLOAK_ADMIN_CLIENT_ID=wishlist-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=
# Public client with direct access grants (current-password verification)
KEYCLOAK_VERIFY_CLIENT_ID=wishlist-cli

# --- app ----------------------------------------------------------------------
# Scheduled purge of rows soft-deleted more than 30 days ago.
PURGE_ENABLED=true
ADS_ENABLED=false
# Link safety: daily-refreshed domain blocklists (set false to disable downloads) and an
# optional Google Web Risk key (empty = no lookup; lookups fail open).
LINK_BLOCKLIST_ENABLED=true
WEB_RISK_API_KEY=
JAVA_OPTS=-XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError
